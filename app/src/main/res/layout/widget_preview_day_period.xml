<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_preview_surface" android:padding="8dp">
    <TextView style="@style/WidgetPreview.title" android:text="@string/widget_preview_location" />
    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_updated" />
    <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:gravity="center_vertical">
            <TextView style="@style/WidgetPreview.bold" android:text="@string/day_period_morning" />
            <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView style="@style/WidgetPreview.body" android:text="@string/widget_preview_morning_range" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_morning_time" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_morning_precipitation" />
                </LinearLayout>
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/weather_clear_day" android:contentDescription="@string/weather_clear" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:layout_marginStart="4dp">
            <TextView style="@style/WidgetPreview.bold" android:text="@string/day_period_afternoon" />
            <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView style="@style/WidgetPreview.body" android:text="@string/widget_preview_afternoon_range" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_afternoon_time" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_afternoon_precipitation" />
                </LinearLayout>
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/weather_partly_cloudy_day" android:contentDescription="@string/widget_preview_partly_cloudy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:gravity="center_vertical">
            <TextView style="@style/WidgetPreview.bold" android:text="@string/day_period_evening" />
            <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView style="@style/WidgetPreview.body" android:text="@string/widget_preview_evening_range" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_evening_time" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_evening_precipitation" />
                </LinearLayout>
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/weather_rain_moderate" android:contentDescription="@string/widget_preview_rain" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:gravity="center_vertical" android:layout_marginStart="4dp">
            <TextView style="@style/WidgetPreview.bold" android:text="@string/day_period_night" />
            <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView style="@style/WidgetPreview.body" android:text="@string/widget_preview_night_range" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_night_time" />
                    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_night_precipitation" />
                </LinearLayout>
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/weather_partly_cloudy_night" android:contentDescription="@string/widget_preview_partly_cloudy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
