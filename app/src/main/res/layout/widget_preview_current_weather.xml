<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_preview_surface" android:padding="8dp">
    <TextView style="@style/WidgetPreview.title" android:text="@string/widget_preview_location" />
    <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_preview_updated" />
    <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView style="@style/WidgetPreview.temperature" android:text="@string/widget_preview_temperature" />
            <TextView style="@style/WidgetPreview.body" android:text="@string/widget_preview_partly_cloudy" />
        </LinearLayout>
        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/weather_partly_cloudy_day" android:contentDescription="@string/widget_preview_partly_cloudy" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:paddingVertical="4dp">
            <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_tile_humidity" />
            <TextView style="@style/WidgetPreview.bold" android:text="@string/widget_preview_humidity" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:paddingVertical="4dp" android:layout_marginStart="4dp">
            <TextView style="@style/WidgetPreview.muted" android:text="@string/detail_wind" />
            <TextView style="@style/WidgetPreview.bold" android:text="@string/widget_preview_wind" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:paddingVertical="4dp" android:layout_marginStart="4dp">
            <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_tile_today_range" />
            <TextView style="@style/WidgetPreview.bold" android:text="@string/widget_preview_afternoon_range" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/widget_preview_tile" android:paddingHorizontal="5dp" android:paddingVertical="4dp" android:layout_marginStart="4dp">
            <TextView style="@style/WidgetPreview.muted" android:text="@string/widget_tile_precipitation_probability" />
            <TextView style="@style/WidgetPreview.bold" android:text="@string/widget_preview_rain_probability" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
