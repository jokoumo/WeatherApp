<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and lower (android:fullBackupContent). Android 12 and newer
    read res/xml/data_extraction_rules.xml instead; both files deliberately describe the same
    policy, see the comments there for the reasoning.

    Policy: everything that a user would want back after a reinstall is backed up, everything that
    can be fetched again is left out. Nothing is included explicitly, so the default "back up the
    app data directory" behaviour stays intact and no preference file can be lost by accident.

    What lives in the app data directory (verified on a running device):
      files/datastore/weather-settings.preferences_pb  home location, favourites, ordering,
                                                       selected location, appearance  -> backed up
      databases/weather-cache (+ -wal, -shm, -journal) Room cache of the forecast responses
                                                       -> excluded, can be requested again
      cache/, code_cache/                              SQLite lock file, JIT caches
                                                       -> never part of a backup anyway
-->
<full-backup-content>
    <!--
        The forecast cache: one row per saved location plus the timestamp of the request. The data
        is a copy of what the weather service returns on demand, so it does not belong in a backup.
        A rule on the database file also covers its "-journal" and "-wal" side files, but the
        "-shm" file is listed explicitly because the platform does not add it.
    -->
    <exclude domain="database" path="weather-cache" />
    <exclude domain="database" path="weather-cache-wal" />
    <exclude domain="database" path="weather-cache-shm" />

    <!-- Review artefact written into files/icon_gallery by the instrumented gallery test; the
         application itself never writes there. -->
    <exclude domain="file" path="icon_gallery" />
</full-backup-content>
