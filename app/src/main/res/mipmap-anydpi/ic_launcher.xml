<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon: sun and cloud foreground over the flat sky blue background, plus the
    monochrome layer that themed launcher icons use. minSdk is 33, so no bitmap fallback is
    needed and the old template bitmaps have been removed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
