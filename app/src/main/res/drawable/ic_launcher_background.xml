<?xml version="1.0" encoding="utf-8"?>
<!--
    Background layer of the adaptive launcher icon: one flat sky blue, the deep end of the app's
    brand palette. Launcher artwork deliberately writes its colours out instead of referencing
    the weather colour tokens: a launcher does not follow the day/night configuration of the
    application, and the icon has to look identical on every home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#17456A" />
</vector>
